# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - CLÍNICA DENTAL DR. ZARAGOZÁ
# ==============================================================================

# Puerto del servidor (en Render se inyecta automáticamente)
PORT=3000

# Zona horaria oficial obligatoria (España Peninsular)
TZ=Europe/Madrid

# Entorno de ejecución
NODE_ENV=production

# Número oficial autorizado de la clínica (único emisor y receptor válido)
OFFICIAL_PHONE=34610812835

# Conexión a Base de Datos PostgreSQL / Supabase para persistencia cloud de WhatsApp y Citas
# Ejemplo Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Control de licencia SaaS (true = activo)
SUBSCRIPTION_ACTIVE=true
